NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://labrat_app:replace-with-url-safe-password@127.0.0.1:5432/labrat
SESSION_SECRET=replace-with-a-long-random-secret
LABRAT_FILE_STORAGE_ROOT=/var/lib/labrat/files
LABRAT_SEED_DEV_ACCOUNTS=false
LABRAT_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-server-only-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=replace-with-server-only-key
ANTHROPIC_MODEL=claude-sonnet-4-5
LABRAT_ANALYSIS_EXECUTOR=disabled
