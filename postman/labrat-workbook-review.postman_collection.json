  "item": [
    {
      "name": "01 Auth and Project",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Creates the httpOnly session cookie. Postman will store it automatically for the base URL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "const json = pm.response.json();",
                  "if (json.user && json.user.id) pm.environment.set('userId', json.user.id);",
                  "if (Array.isArray(json.labs) && json.labs[0] && json.labs[0].labId) pm.environment.set('labId', json.labs[0].labId);"
