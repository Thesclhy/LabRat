    {
      "name": "04 Source Extract to ChartSpec",
      "item": [
        {
          "name": "List Source Extract Proposals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/source-extract-proposals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "source-extract-proposals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('source extract proposals listed', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "const json = pm.response.json();",
                  "if (!pm.environment.get('sourceExtractProposalId') && Array.isArray(json.sourceExtractProposals) && json.sourceExtractProposals[0]) pm.environment.set('sourceExtractProposalId', json.sourceExtractProposals[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Source Extract Proposal From Source Range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceDocumentId\": \"{{sourceDocumentId}}\",\n  \"sheetName\": \"{{sheetName}}\",\n  \"range\": \"{{range}}\",\n  \"extractType\": \"{{extractType}}\",\n  \"purpose\": \"chart_source\",\n  \"intent\": {\n    \"title\": \"Postman source extract\",\n    \"chartTitle\": \"Postman source-backed chart\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/source-extract-proposals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "source-extract-proposals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('source extract proposal created', function () { pm.expect(pm.response.code).to.equal(201); });",
                  "const json = pm.response.json();",
                  "if (json.sourceExtractProposal && json.sourceExtractProposal.id) pm.environment.set('sourceExtractProposalId', json.sourceExtractProposal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept Source Extract Proposal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\",\n  \"decisionSummary\": {\n    \"acceptedByUser\": true,\n    \"note\": \"Accepted through Postman smoke collection.\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/source-extract-proposals/{{sourceExtractProposalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "source-extract-proposals",
                "{{sourceExtractProposalId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('source extract proposal accepted', function () { pm.expect(pm.response.code).to.equal(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Chart Proposal From Accepted Source Extract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/source-extract-proposals/{{sourceExtractProposalId}}/chart-proposal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "source-extract-proposals",
                "{{sourceExtractProposalId}}",
                "chart-proposal"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('chart proposal created from source extract', function () { pm.expect(pm.response.code).to.equal(201); });",
                  "const json = pm.response.json();",
                  "const set = json.chartProposalSet;",
                  "if (set && set.id) pm.environment.set('chartProposalSetId', set.id);",
                  "const proposal = set && set.payload && Array.isArray(set.payload.proposals) ? set.payload.proposals[0] : null;",
                  "if (proposal && proposal.proposalId) pm.environment.set('proposalId', proposal.proposalId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create ChartSpec From Proposal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chartProposalSetId\": \"{{chartProposalSetId}}\",\n  \"proposalId\": \"{{proposalId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/chart-specs/from-proposal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "chart-specs",
                "from-proposal"
              ]
            }
