# Local backend development only. Copy the required values into .env.local.
LABRAT_SEED_DEV_ACCOUNTS=true
SESSION_SECRET=replace-with-a-local-random-secret

# Optional backend model provider configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional development-only Python execution for trusted reviewed code.
# This adapter is not a security sandbox. Production must use the worker adapter.
# LABRAT_ANALYSIS_EXECUTOR=local
# LABRAT_ANALYSIS_PYTHON_COMMAND=python
