# Local backend development only. Copy this file to the Git-ignored .env file.
LABRAT_SEED_DEV_ACCOUNTS=true
SESSION_SECRET=replace-with-a-local-random-secret
DATABASE_URL=postgres://labrat:labrat_dev@127.0.0.1:5433/labrat

# PostgreSQL integration tests do not automatically load this file. Export the
# following value in the test shell when the Compose postgres service is up.
# LABRAT_TEST_DATABASE_URL=postgres://labrat:labrat_dev@127.0.0.1:5433/labrat

# Backend model provider configuration. Docker Compose reads these values from
# the repository-root .env file; do not commit that file.
LABRAT_AI_PROVIDER=deepseek

# Anthropic configuration (used only when LABRAT_AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# DeepSeek configuration (used only when LABRAT_AI_PROVIDER=deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional development-only Python execution for trusted reviewed code.
# This adapter is not a security sandbox. Production must use the worker adapter.
# LABRAT_ANALYSIS_EXECUTOR=local
# LABRAT_ANALYSIS_PYTHON_COMMAND=python
